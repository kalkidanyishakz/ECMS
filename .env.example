# Copy to .env for local development (`npm run dev`).
#
# Docker Compose (docker-compose.yml) does NOT read this file: it injects its own
# values. For reference the compose stack uses:
#   DATABASE_URL        = postgresql://postgres:postgres@db:5432/ecms?schema=ecms
#   BETTER_AUTH_URL     = http://localhost:7080
#   NEXT_PUBLIC_APP_URL = http://localhost:7080
# and publishes the app on http://localhost:7080.

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ecms?schema=ecms"
BETTER_AUTH_SECRET="development-secret-key-12345"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEEPSEEK_API_KEY="your-deepseek-api-key-here"
